DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Comma-separated allowlist for outgoing deal URLs.
SOURCE_DOMAIN_ALLOWLIST=arca.live,quasarzone.com,fmkorea.com,ppomppu.co.kr,eomisae.co.kr

# 1: enforce allowlist, 0: disable allowlist.
ENFORCE_SOURCE_DOMAIN_ALLOWLIST=1

# Comma-separated crawlers to skip entirely (no fetch, no retries, no Playwright).
# fmkorea is off by default: its anti-bot wall blocks server IPs outright.
# Set to empty (DISABLED_CRAWLERS=) to enable all five.
DISABLED_CRAWLERS=fmkorea

# --- fmkorea-only knobs (only matter when fmkorea is enabled) ---
# HTTP(S) proxy for fmkorea requests, e.g. a Korean residential proxy.
# FMKOREA_PROXY=http://user:pass@host:port
# Cookie header copied from a browser session that passed fmkorea's check.
# FMKOREA_COOKIE=
# 1: try headless Chromium (Playwright) when blocked, 0: skip.
FMKOREA_BROWSER_FALLBACK=1
